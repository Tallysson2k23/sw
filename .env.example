SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
COOKIE_SECURE=0
DATABASE=instance/sw.sqlite3

# Local: deixe DATABASE_URL vazio e STORAGE_BACKEND=local.
# Vercel: escolha Firebase abaixo OU PostgreSQL com SSL e STORAGE_BACKEND=s3.
DATABASE_BACKEND=sql
DATABASE_URL=
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Firebase: DATABASE_BACKEND=firestore, STORAGE_BACKEND=firebase e DATABASE_URL vazio.
# JSON privado da conta de serviço (uma linha no .env; nunca usar firebaseConfig web).
FIREBASE_PROJECT_ID=swcursos-325a3
FIREBASE_CREDENTIALS_JSON=
# Alternativa gerada pelo script prepare_firebase_env.py; também é um segredo.
FIREBASE_CREDENTIALS_BASE64=
# Copie o nome exato mostrado em Storage (não inclua gs://).
FIREBASE_STORAGE_BUCKET=swcursos-325a3.firebasestorage.app
